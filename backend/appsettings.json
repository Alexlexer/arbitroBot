{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "ArbitHub.Api": "Debug",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=arbit_hub;Username=postgres;Password=postgres;Port=5432"
  },

  "Jwt": {
    "Key": "CHANGE_ME_REPLACE_WITH_64_CHAR_RANDOM_SECRET_KEY_DO_NOT_COMMIT",
    "Issuer": "arbit-hub",
    "Audience": "arbit-hub-dashboard",
    "ExpiryHours": 24
  },

  "RabbitMq": {
    "Host": "localhost",
    "Port": 5672,
    "Username": "guest",
    "Password": "guest",
    "Exchange": "arbit_hub",
    "RetryDelayMs": 5000
  },

  "History": {
    "BaseUrl": "http://localhost:8080"
  },

  "Auth": {
    "InviteCode": "CHANGE_ME",
    "UsersDbPath": "data/users.db"
  },

  "Cors": {
    "Origins": [
      "http://localhost:5174",
      "http://localhost:5173"
    ]
  },

  "Security": {
    "FailedLoginAttemptsBeforeLock": 5,
    "FailedLoginWindowMinutes": 15,
    "SessionTimeoutMinutes": 60,
    "PasswordMinLength": 8,
    "RequireSpecialChars": true,
    "RequireNumbers": true,
    "RequireUppercase": true
  }
}
